# Superuser / migration connection. Used only by scripts/migrate.ts and seed.
DATABASE_URL_OWNER=postgres://postgres@localhost:5432/lotline

# Application connection. NOBYPASSRLS, no DELETE grant. Everything else uses this.
DATABASE_URL_APP=postgres://lotline_app:lotline_app_dev@localhost:5432/lotline

# Read-only analytics connection. RLS applies identically.
DATABASE_URL_READONLY=postgres://lotline_readonly:lotline_ro_dev@localhost:5432/lotline
